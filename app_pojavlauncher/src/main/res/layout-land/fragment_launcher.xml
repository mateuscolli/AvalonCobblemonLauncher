<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/background_app"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="@dimen/_15sdp">

    <FrameLayout
        android:id="@+id/frame_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_news"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/foreground_gradient_banner"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/minecraft_banner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="right"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_400sdp"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="@dimen/_15sdp">

                <TextView
                    android:id="@+id/news_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_black"
                    android:text="Lorem Ipsum is dummy text of"
                    android:textColor="@color/primary_text"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/news_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Descubra mundos enormes sem fronteiras cheios de diversão e milhões de amigos."
                    android:textColor="@color/primary_text"
                    android:textSize="18sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:orientation="vertical"
                android:padding="@dimen/_15sdp">

                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:layout_editor_absoluteX="19dp">

                    <com.kdt.mcgui.mcAccountSpinner
                        android:id="@+id/account_spinner"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_52sdp"
                        android:layout_weight="1"
                        android:dropDownWidth="match_parent"
                        android:dropDownVerticalOffset="@dimen/_52sdp"
                        android:background="@color/transparent"
                        app:layout_constraintTop_toTopOf="parent" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <com.kdt.mcgui.MineButton
                        android:id="@+id/play_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_60sdp"


                        android:fontFamily="@font/montserrat_black"
                        android:text="@string/main_play"
                        android:textAllCaps="true"
                        android:textSize="@dimen/_20ssp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>


    <!-- This view is for cosmetic purpose only -->

</androidx.constraintlayout.widget.ConstraintLayout>

