<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">


    <!-- Holding most of the dynamic content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/container_menu"
        app:layout_constraintTop_toTopOf="parent" />


    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintBottom_toTopOf="@id/container_menu" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_menu"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_68sdp"
        android:background="#161616"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/home_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/_22sdp"

            android:paddingVertical="@dimen/_8sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_home"
            app:layout_constraintEnd_toStartOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/divider"
            style="@style/LauncherFragment_Divider"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/padding_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tiktok_button"
            app:layout_constraintStart_toEndOf="@id/home_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/tiktok_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/_22sdp"

            android:paddingVertical="@dimen/_8sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_instagram"
            app:layout_constraintEnd_toStartOf="@id/divider1"
            app:layout_constraintStart_toEndOf="@id/divider" />

        <View
            android:id="@+id/divider1"
            style="@style/LauncherFragment_Divider"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/padding_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/discord_button"
            app:layout_constraintStart_toEndOf="@id/tiktok_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/discord_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/_22sdp"

            android:paddingVertical="@dimen/_8sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_discord"
            app:layout_constraintEnd_toStartOf="@id/divider2"
            app:layout_constraintStart_toEndOf="@id/divider1" />

        <View
            android:id="@+id/divider2"
            style="@style/LauncherFragment_Divider"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/padding_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/setting_button"
            app:layout_constraintStart_toEndOf="@id/discord_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/setting_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/_22sdp"

            android:paddingVertical="@dimen/_8sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/divider2" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>